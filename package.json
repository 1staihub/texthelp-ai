{
  "name": "texthelp-ai",
  "version": "1.2.1",
  "description": "Universal AI model API wrapper supporting OpenAI and Anthropic formats with intelligent model-based endpoint selection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "release": "standard-version"
  },
  "keywords": [
    "ai",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "api-wrapper",
    "coze",
    "texthelp",
    "large-language-model",
    "llm"
  ],
  "author": "1staihub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1staihub/texthelp-ai"
  },
  "bugs": {
    "url": "https://github.com/1staihub/texthelp-ai/issues"
  },
  "homepage": "https://github.com/1staihub/texthelp-ai#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
